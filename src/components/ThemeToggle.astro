---
const options = ["light", "dark"];
---

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    font-family: "Victor Mono", ui-monospace, monospace;
    font-size: 0.85rem;
  }

  /* ncurses-style radio: ( ) / (•) */
  .radio {
    color: var(--color-accent);
    opacity: 0.7;
    margin-right: 0.45em;
    transition: opacity 0.15s ease;
  }

  .dot::before {
    content: "\00a0";
  }

  /* Ghost of the selection on hover */
  .toggle-opt:not([aria-pressed="true"]):hover .dot::before,
  .toggle-opt:not([aria-pressed="true"]):focus-visible .dot::before {
    content: "·";
  }

  .toggle-opt:hover .radio,
  .toggle-opt:focus-visible .radio {
    opacity: 1;
  }

  .toggle-opt[aria-pressed="true"] {
    color: var(--color-warm);
    cursor: default;
  }

  .toggle-opt[aria-pressed="true"] .radio {
    opacity: 1;
  }

  .toggle-opt[aria-pressed="true"] .dot::before {
    content: "•";
    color: var(--color-warm);
  }

  .toggle-opt[aria-pressed="true"]:not(.is-struck) .key-label::after {
    display: none;
  }
</style>

<div class="theme-toggle" role="group" aria-label="Theme">
  {options.map((opt) => (
    <button class="key toggle-opt" data-theme-value={opt} aria-pressed="false">
      <span class="radio" aria-hidden="true">(<span class="dot"></span>)</span>
      <span class="key-label" data-label={opt} style={`--n: ${opt.length}`}>{opt}</span>
    </button>
  ))}
</div>

<script is:inline>
  function setTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    document.querySelectorAll("[data-theme-value]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.themeValue === theme));
    });
  }

  document.querySelectorAll("[data-theme-value]").forEach((btn) => {
    btn.addEventListener("click", () => setTheme(btn.dataset.themeValue));
  });

  // Set pressed state on initial load
  const current = document.documentElement.getAttribute("data-theme");
  if (current) setTheme(current);
</script>
