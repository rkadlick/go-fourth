---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "home", current: path === "/" },
  { href: "/projects", label: "projects", current: path === "/projects" },
  { href: "/blog", label: "blog", current: path.startsWith("/blog") },
];
---

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: "Victor Mono", ui-monospace, monospace;
    font-size: 0.9rem;
    margin-bottom: 3rem;
  }

  .site-nav .key {
    color: var(--color-muted);
  }

  /* Current page: the prompt sits here, nothing to type */
  .site-nav .key[aria-current="page"] {
    color: var(--color-warm);
    cursor: default;
  }

  .site-nav .key[aria-current="page"]::before {
    content: ">";
    margin-right: 0.5em;
  }

  .site-nav .key[aria-current="page"] .key-label::after {
    display: none;
  }

  .nav-sep {
    color: var(--color-muted);
  }
</style>

<nav class="site-nav">
  {links.map((link, i) => (
    <>
      {i > 0 && <span class="nav-sep">/</span>}
      <a href={link.href} class="key" aria-current={link.current ? "page" : undefined}>
        <span class="key-label" data-label={link.label} style={`--n: ${link.label.length}`}>{link.label}</span>
      </a>
    </>
  ))}
</nav>
